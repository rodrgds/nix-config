+// Slow down only after notifications actually arrive. Failed registration,
+// a dead pump, or a frame first discovered by polling restores the fallback.
+var heartbeat: Timer?
+func armHeartbeat() {
+    let pumpWorking = notificationPort.map { CFMachPortIsValid($0) } ?? false
+    let interval = notificationsWorking && registrationsWorking && subscriptionsWorking && pumpWorking
+        ? idleInterval : fallbackInterval
+    let timer = Timer(timeInterval: interval, repeats: false) { _ in
+        let now = Date()
+        if !notificationsWorking || !subscriptionsWorking ||
+            now.timeIntervalSince(lastSubscriptionRepair) >= subscriptionRepairInterval {
+            rebuildSubscriptions(force: true)
+            lastSubscriptionRepair = now
+        }
+        let previousFrame = lastFrame
+        let previousApp = shownApp
+        tick()
+        if lastFrame != previousFrame || shownApp != previousApp {
+            notificationsWorking = false
+        }
+        armHeartbeat()
+    }
+    timer.tolerance = interval * 0.1
+    heartbeat = timer
+    RunLoop.current.add(timer, forMode: .common)
+}
+armHeartbeat()

