#!/usr/bin/env bash

set -u

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

export PLUGIN_DIR

# shellcheck source=/dev/null
source "$CONFIG_DIR/theme.sh"

# Home Manager swaps the immutable configuration generation atomically; hotload
# makes that change visible without restarting the Mac or the launch agent.
sketchybar --hotload true

sketchybar --bar \
  position=top \
  height="$BAR_HEIGHT" \
  color="$BG0" \
  shadow=off \
  blur_radius=0 \
  margin=0 \
  y_offset=0 \
  padding_left="$OUTER_GUTTER" \
  padding_right="$OUTER_GUTTER" \
  display=all \
  topmost=on \
  sticky=on

sketchybar --default \
  updates=when_shown \
  drawing=on \
  icon.font="$MONO_FONT:Regular:12.0" \
  icon.color="$FG0" \
  icon.padding_left=5 \
  icon.padding_right=5 \
  label.font="$UI_FONT:Regular:12.0" \
  label.color="$FG0" \
  label.padding_left=0 \
  label.padding_right=5 \
  background.height="$CONTROL_HEIGHT" \
  background.corner_radius="$CORNER_RADIUS" \
  background.color="$TRANSPARENT" \
  background.drawing=on \
  padding_left="$ITEM_GAP" \
  padding_right=0

sketchybar --add event aerospace_workspace_change
sketchybar --add event keyboard_layout_change

TRAY_ITEMS=()

# SketchyBar prepends right-positioned items, so source these in reverse of
# their desired visual order: CPU, RAM, DISK, audio, keyboard, caffeinate,
# tray, clock, power.
for item in \
  workspaces \
  media \
  power \
  clock \
  tray \
  caffeinate \
  keyboard \
  audio \
  metrics
do
  # shellcheck source=/dev/null
  source "$ITEM_DIR/$item.sh"
done

# --reorder lists right-positioned items from the edge inward. Each zero-space
# meter precedes the metric it overlays; keeping the full order explicit also
# prevents aliases from jumping ahead of the system modules.
sketchybar --reorder power clock "${TRAY_ITEMS[@]}" caffeinate keyboard audio \
  disk.meter disk memory.meter memory cpu.meter cpu

sketchybar --update
