#!/usr/bin/env bash

@workspaceSetup@

# One observer reads AeroSpace state once and updates every workspace in one
# SketchyBar call. Per-workspace polling multiplied the same work nine times.
sketchybar --add item workspace.observer left \
  --set workspace.observer \
    drawing=off \
    updates=on \
    script="$PLUGIN_DIR/workspaces.sh" \
  --subscribe workspace.observer \
    aerospace_workspace_change space_windows_change system_woke front_app_switched
