pragma Singleton

import QtQuick
import Quickshell

Singleton {
    readonly property color bg0: "@bg0@"
    readonly property color bg1: "@bg1@"
    readonly property color bg2: "@bg2@"
    readonly property color fg0: "@fg0@"
    readonly property color fgMuted: "@foregroundMuted@"
    readonly property color red: "@red@"
    readonly property color redBright: "@redBright@"
    readonly property color greenBright: "@greenBright@"
    readonly property color yellowBright: "@yellowBright@"
    readonly property color orange: "@orange@"
    readonly property color orangeBright: "@orangeBright@"

    readonly property string monoFont: "@monoFont@"
    readonly property string uiFont: "@uiFont@"
    readonly property int textSize: 12
    readonly property int iconSize: 15
    readonly property int barHeight: @barHeight@
    readonly property int controlHeight: @controlHeight@
    readonly property int controlMinWidth: @controlMinWidth@
    readonly property int outerGutter: @outerGutter@
    readonly property int itemGap: @itemGap@
    readonly property int indicatorHeight: @indicatorHeight@
    readonly property int cornerRadius: @cornerRadius@
    readonly property var workspaceSpecs: @workspaceSpecs@
}
