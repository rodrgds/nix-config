{
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": ["/run/current-system/sw/bin/nixfmt"]
      },
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake \"/home/rgo/.config/home\").nixosConfigurations.rgopc.options"
        },
        "home-manager": {
          "expr": "(builtins.getFlake \"/home/rgo/.config/home\").nixosConfigurations.rgopc.options.home-manager.users.type.getSubOptions []"
        }
      }
    }
  },
  "chat.tools.terminal.autoApprove": {
    "./rebuild": true,
    "nixfmt": true
  }
}
